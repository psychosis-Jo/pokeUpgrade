.shell{min-height:100vh;background:#102621;color:#f7f0dc;padding-bottom:40rpx}.topbar{height:128rpx;padding:30rpx 40rpx 18rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #2b4940}.brand{display:flex;align-items:center;gap:18rpx}.brand-mark{font-size:48rpx;color:#e6b85c}.brand-name{display:block;font-size:34rpx;font-weight:700}.room{display:block;color:#8ba29a;font-size:22rpx;margin-top:5rpx}.voice-btn{margin:0;background:#1c3932;color:#9fb8ad;border:1rpx solid #3b5b50;border-radius:40rpx;font-size:22rpx;padding:10rpx 20rpx}.voice-btn.on{color:#e6b85c;border-color:#8b6b2c}.panel{margin:60rpx 40rpx}.eyebrow{display:block;color:#78968a;letter-spacing:3rpx;font-size:20rpx;font-weight:700}.hero-title{display:block;font-size:72rpx;line-height:1.15;font-weight:800;margin:38rpx 0 20rpx}.hero-title.small{font-size:58rpx}.gold{color:#e7b85b}.hero-sub{display:block;color:#a4b8ae;font-size:27rpx;line-height:1.6}.player-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:55rpx 0}.player-card{position:relative;background:#19362f;border:1rpx solid #2c5145;border-radius:20rpx;padding:24rpx;display:grid;grid-template-columns:70rpx 1fr;align-items:center;font-size:25rpx}.avatar{width:62rpx;height:62rpx;border-radius:50%;background:#d69d45;color:#18312a;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:27rpx;grid-row:span 2}.level{grid-column:2;color:#90aa9f;font-size:21rpx;margin-top:5rpx}.guest{position:absolute;right:16rpx;top:16rpx;color:#e7b85b;font-size:17rpx}.primary{background:#e6b457!important;color:#173129!important;border:0;border-radius:14rpx;font-weight:800}.wide{width:100%;padding:24rpx;font-size:29rpx}.hint{display:block;text-align:center;color:#6f8b80;font-size:21rpx;margin-top:20rpx}.step{display:flex;align-items:center;color:#7e9c90;font-size:22rpx}.step-dot{width:36rpx;height:36rpx;border:1rpx solid #55756a;border-radius:50%;display:flex;align-items:center;justify-content:center}.step-dot.active{background:#e6b457;color:#173129;border-color:#e6b457}.line{height:1rpx;background:#3c5a50;flex:1;margin:0 13rpx}.call .hero-title{margin-top:70rpx}.suit-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:50rpx 0}.suit{height:160rpx;background:#193b32;color:#e9f0e8;border:1rpx solid #41685a;border-radius:20rpx;font-size:54rpx}.suit.red{color:#df7467}.suit text:last-child{display:block;font-size:23rpx;color:#9bb2a8;margin-top:10rpx}.rule-note{background:#1a342e;border-radius:14rpx;padding:22rpx;color:#8fa99f;font-size:21rpx;line-height:1.7}.rule-note text:first-child{display:block;color:#e6b457;font-weight:700}.table-stage{padding:34rpx 30rpx}.table-head{display:flex;justify-content:space-between;align-items:end;padding:0 10rpx 24rpx}.table-title{display:block;font-size:34rpx;font-weight:700;margin-top:10rpx}.dealer-pill{border:1rpx solid #8b6b2c;color:#e6b457;padding:12rpx 18rpx;border-radius:30rpx;font-size:22rpx}.felt{position:relative;height:730rpx;background:radial-gradient(circle,#28554a,#17382f 70%);border:8rpx solid #d09c4d;border-radius:42rpx;box-shadow:0 12rpx 40rpx #071814;overflow:hidden}.seat{position:absolute;display:flex;flex-direction:column;align-items:center;font-size:22rpx}.seat.top{top:24rpx;left:45%}.seat.left{left:24rpx;top:42%}.seat.right{right:24rpx;top:42%}.small-avatar{width:58rpx;height:58rpx;margin-bottom:7rpx}.muted{display:block;color:#87a297;font-size:19rpx;margin-top:5rpx}.center-trick{position:absolute;left:20%;right:20%;top:34%;height:220rpx;display:flex;justify-content:center;align-items:center;gap:10rpx}.center-tip{color:#83a79a;font-size:24rpx}.mini-play{display:flex;flex-direction:column;align-items:center;color:#b0c4bb;font-size:18rpx}.mini-card{background:#fff8e9;border-radius:9rpx;color:#222;width:62rpx;height:86rpx;padding:9rpx;box-sizing:border-box;margin-top:5rpx;font-size:21rpx;box-shadow:0 3rpx 10rpx #102a22}.mini-card.red{color:#c94746}.score-strip{position:absolute;bottom:35rpx;left:0;right:0;text-align:center;color:#8dad9f;font-size:21rpx}.score{color:#e6b457;font-size:46rpx;font-weight:800;margin-left:12rpx}.score small{font-size:20rpx;color:#849d92}.hand{display:flex;gap:8rpx;margin:24rpx 0;overflow-x:auto;padding:12rpx 6rpx}.card{flex:0 0 76rpx;height:112rpx;background:#fff8e9;color:#242622;border-radius:10rpx;padding:13rpx;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;font-weight:800;font-size:25rpx;box-shadow:0 4rpx 10rpx #091c17}.card.red{color:#c94746}.card.selected{transform:translateY(-18rpx);box-shadow:0 0 0 4rpx #e6b457,0 8rpx 15rpx #091c17}.play-btn{width:100%;padding:22rpx;font-size:28rpx}.result{text-align:center;margin-top:100rpx}.confetti{color:#e6b457;font-size:70rpx}.result-score{display:block;color:#a4b8ae;font-size:27rpx;margin:24rpx}.result-score text{color:#e6b457;font-size:64rpx;font-weight:800}.highlight,.reward{background:#19362f;border:1rpx solid #345b4d;border-radius:18rpx;padding:24rpx;text-align:left;margin:26rpx 0}.highlight text,.reward text{display:block}.highlight text:first-child{color:#e6b457;font-size:21rpx;margin-bottom:9rpx}.highlight text:last-child{color:#d4e0d9;font-size:24rpx}.reward{display:flex;gap:18rpx;align-items:center}.reward-icon{font-size:50rpx!important}.reward text:first-of-type{font-size:25rpx}.interaction-drawer{position:fixed;left:0;right:0;bottom:0;background:#17332c;border-top:1rpx solid #3c6557;border-radius:28rpx 28rpx 0 0;padding:28rpx 30rpx 38rpx;box-shadow:0 -12rpx 35rpx #081712}.drawer-title{display:flex;justify-content:space-between;font-size:23rpx;margin-bottom:20rpx}.target-row,.interaction-row{display:flex;gap:15rpx;margin-bottom:22rpx}.target{flex:1;text-align:center;border:1rpx solid transparent;border-radius:14rpx;padding:10rpx;font-size:19rpx}.target.chosen,.interaction.chosen{border-color:#e6b457;background:#23483c}.tiny{width:52rpx;height:52rpx;margin:auto auto 7rpx;font-size:22rpx}.interaction{flex:1;background:#214